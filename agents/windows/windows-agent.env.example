# Windows 指标 Agent —— 配置模板
#
# 复制到 %ProgramData%\taishan-hub\windows-agent.env 再填真实密码。
# 真实文件不进仓库（.gitignore 里 credentials.env / *.secrets 已排除，
# 这个文件名也请勿提交）。安装脚本 install-windows.ps1 会自动生成它。
#
# 改完重启任务：schtasks /End /TN TaishanHubWindowsAgent
#               schtasks /Run /TN TaishanHubWindowsAgent

# 设备标识，必须与 ACL 里 windows-agent 能写的主题一致
WINDOWS_DEVICE_ID=windows-main

# 泰山派 Hub
MOSQUITTO_HOST=192.168.0.156
MOSQUITTO_PORT=1883

# Hub 上 /etc/taishan-hub/credentials.env 里的 WINDOWS_AGENT_USER / WINDOWS_AGENT_PASS
WINDOWS_AGENT_USER=windows-agent
WINDOWS_AGENT_PASS=<从 credentials.env 取，不要写进仓库>

# 看哪块盘的容量
WINDOWS_DISK_PATH=C:\

# 要监控的 Windows 服务（逗号分隔，留空则不上报 services）
WINDOWS_SERVICES=W32Time