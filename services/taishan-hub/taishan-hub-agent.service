[Unit]
Description=Taishan Hub metrics agent (MQTT publisher)
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
Type=simple
# 以普通用户运行：Agent 只读系统指标 + 发布 MQTT，不需要 root。
User=lckfb
Group=lckfb
WorkingDirectory=/opt/taishan-hub/agent
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/taishan-hub/agent/agent.py

# 最小权限沙箱。注意：不能开 MemoryDenyWriteExecute，CPython + libffi 会崩。
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

Restart=always
RestartSec=5
# 不因反复失败而永久放弃：Broker 晚起来时也要自己恢复。
StartLimitIntervalSec=0

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
